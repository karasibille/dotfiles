##########################################
# configuration for workspace behaviour: #
##########################################

# Define names for default workspaces for which we configure key bindings later on.
# We use variables to avoid repeating the names in multiple places.
# 一二三四五六七八九十
set $ws1 "1:一"
set $ws2 "2:二"
set $ws3 "3:三"
set $ws4 "4:四"
set $ws5 "5:五"
set $ws6 "6:六"
set $ws7 "7:七"
set $ws8 "8:八"
set $ws9 "9:九"
set $ws10 "10:十"

#############################################
# autostart applications/services on login: #
#############################################

# get auth work with polkit-gnome
# (Arch: /usr/lib/polkit-gnome, Ubuntu: /usr/lib/policykit-1-gnome)
exec --no-startup-id sh -c 'for a in /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1; do [ -x "$a" ] && exec "$a"; done'

# Monitors: apply the saved autorandr profile matching the connected screens
# (autorandr --save <name>); its postswitch hook restarts polybar
exec --no-startup-id autorandr --change

# Compose key on right Ctrl. X drops it when it detects a keyboard again
# (plugged in, dock, resume from suspend): exec_always so that $mod+Shift+r
# restores it; the lasting fix is system-wide, see the README (Keyboard)
exec_always --no-startup-id setxkbmap -option compose:rctrl

# transparency
# uncomment one of them to be used (picom package is installed per default)
# options could need changes, related to used GPU and drivers.
# to find the right setting consult the archwiki or ask at the forum.
# xcompmgr: https://wiki.archlinux.org/title/Xcompmgr
#exec --no-startup-id xcompmgr -C -n &
# or an more specialized config like this:
#exec --no-startup-id xcompmgr -c -C -t-5 -l-5 -r4.2 -o.55 &
# or:
# picom: https://wiki.archlinux.org/title/Picom
exec --no-startup-id picom

# GTK settings (theme switched live by bin/theme)
exec --no-startup-id xsettingsd

# Polybar
exec_always --no-startup-id $HOME/.config/polybar/launch.sh

# set the theme's wallpaper (bin/theme), and build the lock image from it so
# locking is instant
exec_always feh --no-fehbg --bg-fill $HOME/.local/state/theme/wallpaper
exec_always --no-startup-id ~/.local/bin/lock --prepare

# Lock when nobody is in front of the screen, if AUTOLOCK is set (bin/autolock)
exec --no-startup-id ~/.local/bin/autolock

# set powersavings for display:
exec --no-startup-id xset s off -dpms

# Autostart some apps
# (unless still running from a previous session; toggled from polybar)
exec --no-startup-id sleep 1 && (pgrep -x redshift >/dev/null || exec redshift)

# set floating (nontiling)for apps needing it
for_window [class="Yad" instance="yad"] floating enable
for_window [class="Pavucontrol" instance="pavucontrol"] floating enable

######################################
# color settings for bar and windows #
######################################

# Define colors variables:
set_from_resource   $background i3wm.background  #2E3440
set_from_resource   $text       i3wm.foreground #E5E9F0
set_from_resource   $indicator  i3wm.color5     #B48EAD

set_from_resource   $workspace  i3wm.color4     #5E81AC
set_from_resource   $focused    i3wm.color1     #B48EAD
set_from_resource   $unfocused  i3wm.color0     #2E3440
set_from_resource   $inactive   i3wm.color8     #4C566A
set_from_resource   $urgent     i3wm.color5     #BF616A

# define colors for windows:
# class                 border      backgr.     text        indicator   child_border
client.focused          $focused    $focused    $background $indicator  $focused
client.focused_inactive $focused    $focused    $background $inactive   $inactive
client.unfocused        $background $background $focused    $inactive   $inactive
client.urgent           $urgent     $urgent     $background $urgent     $urgent
client.background       $background

#####################################
# Application menu handled by rofi: #
#####################################

## rofi bindings fancy application menu ($mod+d)
bindsym $mod+d exec rofi -modi drun -show drun -config ~/.config/rofi/config.rasi

## color theme picker
bindsym $mod+Shift+t exec --no-startup-id ~/.local/bin/theme

## rofi bindings for window menu ($mod+Shift+d)
bindsym $mod+Shift+D exec rofi -show window -config ~/.config/rofi/config.rasi
