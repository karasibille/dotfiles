color = ${colors.blue}
type = internal/network
; First wireless interface (wlan0, wlp58s0… depending on the machine)
interface-type = wireless

interval = 5.0

accumulate-stats = true

unknown-as-up = false

; Click: nmtui, in the first installed terminal (as $term in i3/config).
; Icon only when connected: the network name stays off the screen.
format-connected = %{A1:sh -c 'exec "$(command -v kitty || command -v alacritty || echo i3-sensible-terminal)" -e nmtui' &:}<ramp-signal>%{A}

format-disconnected = %{A1:sh -c 'exec "$(command -v kitty || command -v alacritty || echo i3-sensible-terminal)" -e nmtui' &:}<label-disconnected>%{A}


label-disconnected = 
label-disconnected-foreground = ${self.color}

ramp-signal-0 = 
ramp-signal-1 = 
ramp-signal-2 = 
ramp-signal-3 = 
ramp-signal-4 = 
ramp-signal-5 = 
ramp-signal-foreground = ${self.color}
