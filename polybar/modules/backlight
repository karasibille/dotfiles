color = ${colors.blue}
type = internal/backlight

; Detected by launch.sh (intel_backlight, amdgpu_bl0…)
card = ${env:BACKLIGHT:intel_backlight}

; Scrolling writes to /sys: needs udev/90-backlight.rules and the video group
enable-scroll = true

format = <label>
format-prefix = " "
format-prefix-foreground = ${self.color}

label = %percentage%%
