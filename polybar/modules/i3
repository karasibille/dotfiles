type = internal/i3

; Each bar only shows the workspaces of its monitor
pin-workspaces = true

strip-wsnumbers = true

index-sort = true

enable-click = true

enable-scroll = false

wrapping-scroll = false

reverse-scroll = false

format = <label-state> <label-mode>

label-mode = %mode%
label-mode-padding = 2

label-focused = %name%
label-focused-background = ${colors.focused}
label-focused-foreground = ${colors.focused-foreground}
label-focused-padding = ${self.label-mode-padding}

label-unfocused = %name%
label-unfocused-foreground = ${colors.workspaces}
label-unfocused-padding = ${self.label-mode-padding}

label-visible = %name%
label-visible-foreground = ${colors.workspaces}
label-visible-padding = ${self.label-mode-padding}

label-urgent = %name%
label-urgent-foreground = ${colors.foreground-alt}
label-urgent-background = ${colors.primary}
label-urgent-padding = ${self.label-mode-padding}
