color = ${colors.red}
type = internal/temperature

interval = 1

; CPU package sensor, found by type: zone and hwmon numbers vary between boots
; and machines
zone-type = x86_pkg_temp

warn-temperature = 80

units = false

format = <ramp> <label>

format-warn = <ramp> <label-warn>

label = %temperature-c% °C

label-warn = %temperature-c% °C

ramp-0 = 
ramp-1 = 
ramp-2 = 
ramp-3 = 
ramp-4 = 
ramp-foreground = ${self.color}
