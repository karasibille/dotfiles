monitor = ${env:MONITOR:eDP1}

monitor-strict = false

override-redirect = false

bottom = false

fixed-center = true

width = 100%
height = 32

offset-x = 25
offset-y = 0

; theme.bar.background and theme.bar.opacity of the active theme (bin/theme)
background = ${colors.background}

foreground = ${colors.foreground}

radius = 0.0

line-size = 3
line-color = ${colors.primary}

padding-right = 2

module-margin-right = 2

font-0 = Source Code Pro:style=Medium:antialias=true:pixelsize=11;1
font-1 = Font Awesome 7 Free:style=Solid:antialias=true:pixelsize=10;1
font-3 = Font Awesome 7 Brands:antialias=true:pixelsize=10;1
font-2 = Source Han Sans JP:style=Bold:pixelsize=11;1
; Same typeface as font-2 under Ubuntu's name (fonts-noto-cjk)
font-4 = Noto Sans CJK JP:style=Bold:pixelsize=11;1

modules-left = i3
modules-center = date
; Same list without backlight in bar/top-nobacklight (config.ini)
modules-right = info-redshift-temp backlight volume xkeyboard memory cpu temperature battery powermenu

