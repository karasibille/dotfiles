#!/usr/bin/env python3
"""Put workspaces 1-8 on the primary monitor, 9 and 10 on the others.

9 goes to the leftmost other monitor, 10 to the rightmost; with a single other
monitor both go there, with no other monitor everything stays on the primary.
Run by i3 at startup and by the autorandr postswitch hook: workspaces moved by
hand stay where they are until the next monitor change.
"""

import json
import re
import subprocess


def i3(kind, payload=""):
    out = subprocess.run(["i3-msg", "-t", kind, payload], capture_output=True, text=True, check=True).stdout
    # i3-msg prints get_config as plain text
    return out if kind == "get_config" else json.loads(out)


def command(cmd):
    i3("command", cmd)


def quote(name):
    return '"' + name.replace("\\", "\\\\").replace('"', '\\"') + '"'


def main():
    outputs = [o for o in i3("get_outputs") if o["active"]]
    if not outputs:
        return
    outputs.sort(key=lambda o: (o["rect"]["x"], o["rect"]["y"]))
    primary = next((o for o in outputs if o["primary"]), outputs[0])
    others = [o["name"] for o in outputs if o is not primary]

    def target(num):
        if num == 9 and others:
            return others[0]
        if num == 10 and others:
            return others[-1]
        return primary["name"]

    # Workspace names, from the set $wsN "N:…" lines of the i3 config
    config = i3("get_config")
    names = {int(n): name for n, name in re.findall(r'^\s*set\s+\$ws(\d+)\s+"([^"]+)"', config, re.MULTILINE)}

    workspaces = i3("get_workspaces")
    focused = next((w["name"] for w in workspaces if w["focused"]), None)

    def sort():
        for w in i3("get_workspaces"):
            if 1 <= w["num"] <= 10 and w["output"] != target(w["num"]):
                command(f"workspace --no-auto-back-and-forth {quote(w['name'])}; "
                        f"move workspace to output {quote(target(w['num']))}")

    # i3 refills an output emptied by a move with the first free bound name,
    # often 9 or 10 on the wrong output: sort again once they exist
    sort()
    for num in (9, 10):
        exists = any(w["num"] == num for w in i3("get_workspaces"))
        if num in names and not exists and target(num) != primary["name"]:
            command(f"focus output {quote(target(num))}; workspace --no-auto-back-and-forth {quote(names[num])}")
    sort()

    if any(w["name"] == focused for w in i3("get_workspaces")):
        command(f"workspace --no-auto-back-and-forth {quote(focused)}")


if __name__ == "__main__":
    main()
