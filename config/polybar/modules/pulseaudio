color = ${colors.blue}
type = internal/pulseaudio

use-ui-max = false

; Left click mutes; right click opens pavucontrol to pick the output device
click-right = pavucontrol --tab=3 &

format-volume = <ramp-volume> <label-volume>

format-muted = <label-muted>

label-muted =  

ramp-volume-0 = 
ramp-volume-1 = 
ramp-volume-2 = 
ramp-volume-foreground = ${self.color}
