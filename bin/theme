#!/usr/bin/env python3
"""Switch the color theme of every tool at once.

A theme is an X resources file in xrdb/colors/. Its colors are written to a
generated file for each tool (kitty, alacritty, rofi, dunst, polybar), its GTK
theme to xsettingsd, its wallpaper is set, then the running programs are
reloaded.

    theme               pick a theme (rofi, or a prompt in a terminal)
    theme NAME          switch to NAME
    theme --list        list the themes, * marks the current one

Besides background, foreground, cursorColor and color0-15, a theme can set
(otherwise the fallback in parentheses is used):

    theme.accent             rofi selection and border, dunst frame (color5)
    theme.selection          selection background (color8)
    theme.bar.background     polybar background (background)
    theme.bar.opacity        polybar background opacity, in percent (80)
    theme.bar.foreground     polybar foreground (foreground)
    theme.bar.foregroundAlt  polybar secondary text (color8)
    theme.bar.primary        polybar highlights (color5)
    theme.bar.secondary      polybar secondary highlights (color3)
    theme.bar.focused        polybar focused workspace background (theme.bar.foreground)
    theme.bar.red, .green, .yellow, .blue, .purple, .cyan
                             polybar module colors (color1 to color6)
    theme.gtk                GTK theme name (gtk-theme-name of gtk-3.0/settings.ini)
    theme.wallpaper          wallpaper image, ~ allowed (solid background color)

GTK applications switch theme live when xsettingsd is installed; otherwise only
newly started ones use gtk-3.0/settings.ini.

The wallpaper in use is the symlink ~/.local/state/theme/wallpaper, also read
by i3 at startup and by bin/lock. Wallpapers are not versioned.
"""
import argparse
import configparser
import os
import re
import shutil
import struct
import subprocess
import sys
import zlib
from pathlib import Path

DOTFILES = Path(__file__).resolve().parent.parent
THEMES = DOTFILES / "xrdb" / "colors"
# Symlink to the active theme, included by Xresources
CURRENT = DOTFILES / "xrdb" / "current"
GTK_SETTINGS = DOTFILES / "gtk-3.0" / "settings.ini"
XSETTINGSD = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "xsettingsd" / "xsettingsd.conf"
STATE = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local" / "state")) / "theme"
# Symlink to the wallpaper in use (image of the theme or solid color)
WALLPAPER = STATE / "wallpaper"

OPTIONAL = {
    "cursor": ("cursorColor", "foreground"),
    "accent": ("theme.accent", "color5"),
    "selection": ("theme.selection", "color8"),
    "bar_background": ("theme.bar.background", "background"),
    "bar_foreground": ("theme.bar.foreground", "foreground"),
    "bar_foreground_alt": ("theme.bar.foregroundAlt", "color8"),
    "bar_primary": ("theme.bar.primary", "color5"),
    "bar_secondary": ("theme.bar.secondary", "color3"),
    # Module colors, to keep icons readable on the bar background
    **{f"bar_{c}": (f"theme.bar.{c}", f"color{i}")
       for i, c in enumerate(["red", "green", "yellow", "blue", "purple", "cyan"], 1)},
}

HEADER = "Generated by bin/theme from xrdb/colors/{name}, do not edit"

TEMPLATES = {
    "kitty/theme.generated.conf": """\
# {header}
foreground            {foreground}
background            {background}
selection_foreground  {foreground}
selection_background  {selection}
cursor                {cursor}
cursor_text_color     {background}
url_color             {color6}

color0   {color0}
color1   {color1}
color2   {color2}
color3   {color3}
color4   {color4}
color5   {color5}
color6   {color6}
color7   {color7}
color8   {color8}
color9   {color9}
color10  {color10}
color11  {color11}
color12  {color12}
color13  {color13}
color14  {color14}
color15  {color15}
""",
    "alacritty/theme.generated.toml": """\
# {header}
[colors.primary]
background = "{background}"
foreground = "{foreground}"

[colors.cursor]
cursor = "{cursor}"
text = "{background}"

[colors.selection]
background = "{selection}"
text = "{foreground}"

[colors.normal]
black   = "{color0}"
red     = "{color1}"
green   = "{color2}"
yellow  = "{color3}"
blue    = "{color4}"
magenta = "{color5}"
cyan    = "{color6}"
white   = "{color7}"

[colors.bright]
black   = "{color8}"
red     = "{color9}"
green   = "{color10}"
yellow  = "{color11}"
blue    = "{color12}"
magenta = "{color13}"
cyan    = "{color14}"
white   = "{color15}"
""",
    "rofi/theme.generated.rasi": """\
/* {header} */
* {{
    background:       {background};
    foreground:       {foreground};
    background-color: @background;
    border-color:     {accent};
    bordercolor:      @border-color;
    separatorcolor:   @border-color;

    normal-background: @background;
    normal-foreground: @foreground;
    active-background: @background;
    active-foreground: {color4};
    urgent-background: @background;
    urgent-foreground: {color1};

    selected-normal-background: {selection};
    selected-normal-foreground: {accent};
    selected-active-background: {selection};
    selected-active-foreground: {color4};
    selected-urgent-background: {selection};
    selected-urgent-foreground: {color1};

    /* No alternate colors */
    alternate-normal-background: @normal-background;
    alternate-normal-foreground: @normal-foreground;
    alternate-active-background: @active-background;
    alternate-active-foreground: @active-foreground;
    alternate-urgent-background: @urgent-background;
    alternate-urgent-foreground: @urgent-foreground;

    spacing: 2;
}}
""",
    # Drop-in read after dunstrc (dunst >= 1.7)
    "dunst/dunstrc.d/theme.generated.conf": """\
# {header}
[global]
    frame_color = "{accent}"

[urgency_low]
    background = "{background}"
    foreground = "{foreground}"

[urgency_normal]
    background = "{background}"
    foreground = "{foreground}"

[urgency_critical]
    background = "{background}"
    foreground = "{foreground}"
    frame_color = "{color1}"
""",
    "polybar/colors/theme.generated": """\
; {header}
background = {bar_background_argb}
background-alt = {selection}
foreground = {bar_foreground}
foreground-alt = {bar_foreground_alt}

red = {bar_red}
green = {bar_green}
yellow = {bar_yellow}
blue = {bar_blue}
purple = {bar_purple}
cyan = {bar_cyan}

primary = {bar_primary}
secondary = {bar_secondary}
focused = {bar_focused}
urgent = {color1}
""",
}


def themes():
    return sorted(p.name for p in THEMES.iterdir() if p.is_file())


def current():
    return os.path.basename(os.readlink(CURRENT)) if CURRENT.is_symlink() else None


def parse(path):
    """Read the #define macros and the resources of an X resources file."""
    defines, resources = {}, {}
    for line in path.read_text().splitlines():
        line = line.strip()
        if m := re.match(r"#define\s+(\S+)\s+(\S+)", line):
            defines[m[1]] = m[2]
        # "*color0: nord1", "*.foreground: X", "theme.wallpaper: ~/a b.png"
        elif m := re.match(r"\*?\.?([\w.]+)\s*:\s*(.+?)\s*$", line):
            resources[m[1]] = defines.get(m[2], m[2])
    return resources


def is_color(value):
    return bool(value and re.fullmatch(r"#[0-9a-fA-F]{6}", value))


def palette(resources, name):
    required = ["background", "foreground"] + [f"color{i}" for i in range(16)]
    missing = [key for key in required if not is_color(resources.get(key))]
    if missing:
        sys.exit(f"theme {name}: missing or invalid colors: {', '.join(missing)}")

    colors = {key: resources[key] for key in required}
    for key, (resource, fallback) in OPTIONAL.items():
        value = resources.get(resource)
        colors[key] = value if is_color(value) else colors[fallback]
    focused = resources.get("theme.bar.focused")
    colors["bar_focused"] = focused if is_color(focused) else colors["bar_foreground"]

    opacity = resources.get("theme.bar.opacity", "80")
    if not opacity.isdigit() or int(opacity) > 100:
        sys.exit(f"theme {name}: theme.bar.opacity must be a percentage, not {opacity!r}")
    # polybar reads #AARRGGBB
    alpha = round(int(opacity) * 255 / 100)
    colors["bar_background_argb"] = f"#{alpha:02X}{colors['bar_background'][1:]}"
    return colors


def gtk_themes():
    dirs = [Path.home() / ".themes", Path.home() / ".local/share/themes", Path("/usr/share/themes")]
    return {p.name for d in dirs if d.is_dir() for p in d.iterdir()}


def gtk_settings(resources, name):
    """GTK settings for xsettingsd: settings.ini, with the theme's GTK theme."""
    ini = configparser.ConfigParser(interpolation=None)
    ini.read(GTK_SETTINGS)
    defaults = ini["Settings"] if ini.has_section("Settings") else {}

    settings = {
        "Net/ThemeName": resources.get("theme.gtk", defaults.get("gtk-theme-name")),
        "Net/IconThemeName": defaults.get("gtk-icon-theme-name"),
        "Gtk/CursorThemeName": defaults.get("gtk-cursor-theme-name"),
        "Gtk/FontName": defaults.get("gtk-font-name"),
    }
    gtk_theme = settings["Net/ThemeName"]
    if gtk_theme and gtk_theme not in gtk_themes():
        print(f"theme {name}: GTK theme {gtk_theme!r} is not installed", file=sys.stderr)
    return {key: value for key, value in settings.items() if value}


def solid_png(color, path):
    """Write a 1x1 PNG of color; feh --bg-fill stretches it to the screen."""
    def chunk(kind, data):
        return struct.pack(">I", len(data)) + kind + data + struct.pack(">I", zlib.crc32(kind + data))

    pixel = bytes.fromhex(color[1:])
    path.write_bytes(
        b"\x89PNG\r\n\x1a\n"
        + chunk(b"IHDR", struct.pack(">IIBBBBB", 1, 1, 8, 2, 0, 0, 0))
        + chunk(b"IDAT", zlib.compress(b"\x00" + pixel))
        + chunk(b"IEND", b"")
    )


def set_wallpaper(resources, colors, name):
    """Point WALLPAPER to the theme's image, or to a solid background color."""
    STATE.mkdir(parents=True, exist_ok=True)
    image = resources.get("theme.wallpaper")
    if image:
        image = Path(image).expanduser()
        if not image.is_file():
            print(f"theme {name}: wallpaper {str(image)!r} not found, using a solid color", file=sys.stderr)
            image = None
    if not image:
        image = STATE / f"solid-{colors['background'][1:].lower()}.png"
        solid_png(colors["background"], image)

    if WALLPAPER.is_symlink() or WALLPAPER.exists():
        WALLPAPER.unlink()
    WALLPAPER.symlink_to(image)
    return image


def generate(name):
    resources = parse(THEMES / name)
    colors = palette(resources, name)
    header = HEADER.format(name=name)
    for target, template in TEMPLATES.items():
        path = DOTFILES / target
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(template.format(header=header, **colors))

    # Outside the repository: xsettingsd has no config to version
    settings = gtk_settings(resources, name)
    XSETTINGSD.parent.mkdir(parents=True, exist_ok=True)
    XSETTINGSD.write_text(
        f"# {header}\n" + "".join(f'{key} "{value}"\n' for key, value in settings.items())
    )
    colors["gtk"] = settings.get("Net/ThemeName")
    colors["wallpaper"] = set_wallpaper(resources, colors, name)

    if CURRENT.is_symlink() or CURRENT.exists():
        CURRENT.unlink()
    CURRENT.symlink_to(Path("colors") / name)
    return colors


def running(process):
    return subprocess.run(["pgrep", "-x", process], capture_output=True, check=False).returncode == 0


def run(*command):
    if shutil.which(command[0]):
        subprocess.run(command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)


def reload():
    if os.environ.get("DISPLAY"):
        run("xrdb", "-load", str(Path.home() / ".Xresources"))
    # i3 reloads its colors from xrdb
    if running("i3"):
        run("i3-msg", "reload")
    # A reload doesn't run i3's exec_always, so polybar is restarted here: in
    # place over IPC (quicker, windows don't move), or relaunched if no bar
    # answers (started before enable-ipc)
    if running("polybar"):
        restarted = subprocess.run(
            ["polybar-msg", "cmd", "restart"], capture_output=True, check=False
        ).returncode == 0
        if not restarted:
            subprocess.Popen(
                [str(DOTFILES / "polybar" / "launch.sh")],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
    if running("kitty"):
        run("pkill", "-USR1", "-x", "kitty")
    if running("dunst"):
        run("dunstctl", "reload")
    reload_gtk()
    if os.environ.get("DISPLAY"):
        run("feh", "--no-fehbg", "--bg-fill", str(WALLPAPER))
        # Build the lock image now so the next lock is instant
        subprocess.Popen(
            [str(DOTFILES / "bin" / "lock"), "--prepare"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    # alacritty reloads its imported files by itself


def reload_gtk():
    # xsettingsd pushes the new GTK theme to running applications
    if running("xsettingsd"):
        run("pkill", "-HUP", "-x", "xsettingsd")
    elif os.environ.get("DISPLAY") and shutil.which("xsettingsd"):
        subprocess.Popen(
            ["xsettingsd"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )


def notify(name, colors):
    """Show the new palette in a notification, itself drawn with the new theme."""
    if not (os.environ.get("DISPLAY") and shutil.which("notify-send")):
        return
    swatches = ["".join(f'<span foreground="{colors[f"color{i}"]}">██</span>' for i in row)
                for row in (range(8), range(8, 16))]
    if colors.get("gtk"):
        swatches.append(f"GTK: {colors['gtk']}")
    if not colors["wallpaper"].name.startswith("solid-"):
        swatches.append(f"Wallpaper: {colors['wallpaper'].name}")
    run(
        "notify-send",
        "--app-name=theme",
        "--icon=preferences-desktop-theme",
        # Replace the previous theme notification instead of stacking them
        "--hint=string:x-dunst-stack-tag:theme",
        f"Theme: {name}",
        "\n".join(swatches),
    )


def choose():
    names, active = themes(), current()
    if os.environ.get("DISPLAY") and shutil.which("rofi"):
        selected = names.index(active) if active in names else 0
        result = subprocess.run(
            ["rofi", "-dmenu", "-i", "-p", "theme", "-selected-row", str(selected)],
            input="\n".join(names),
            capture_output=True,
            text=True,
            check=False,
        )
        return result.stdout.strip() or None

    for i, name in enumerate(names, 1):
        print(f"{i}) {name}{' *' if name == active else ''}")
    answer = input("theme: ").strip()
    if answer.isdigit() and 1 <= int(answer) <= len(names):
        return names[int(answer) - 1]
    return answer or None


def main():
    parser = argparse.ArgumentParser(description="Switch the color theme of every tool at once.")
    parser.add_argument("name", nargs="?", help="theme to apply (default: pick one)")
    parser.add_argument("--list", action="store_true", help="list the themes")
    parser.add_argument("--no-reload", action="store_true", help="only generate the files")
    args = parser.parse_args()

    if args.list:
        active = current()
        for name in themes():
            print(f"{name}{' *' if name == active else ''}")
        return

    name = args.name or choose()
    if not name:
        return
    if name not in themes():
        sys.exit(f"unknown theme {name!r}, available: {', '.join(themes())}")

    colors = generate(name)
    if not args.no_reload:
        reload()
        notify(name, colors)
    print(f"theme: {name}")


if __name__ == "__main__":
    main()
